# ===========================================================================
# Configuration INTER COLIS SERVICES — copiez ce fichier en « .env »
# et renseignez vos valeurs. NE COMMITEZ JAMAIS le fichier .env réel.
# ===========================================================================

# Port d'écoute interne de l'application (nginx fera le lien avec le port 80/443)
PORT=3000

# Secret de signature des sessions (OBLIGATOIRE en production).
# Générez-en un avec :  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacez-par-une-longue-valeur-aleatoire

# Emplacement de la base de données (fichier JSON). Laissez tel quel ou
# pointez vers un dossier sauvegardé (ex. /home/ics/data).
DATA_DIR=/home/ics/inter-colis/data

# Chiffrement des données AU REPOS (AES-256-GCM). Si cette clé est définie, le
# fichier database.json est chiffré sur le disque : illisible sans la clé.
# Générez-en une avec :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ CONSERVEZ-LA précieusement : sans elle, les données chiffrées sont irrécupérables.
DATA_ENCRYPTION_KEY=

# --- Géolocalisation PAJ GPS (facultatif) ----------------------------------
# Clé de chiffrement dédiée au mot de passe du compte PAJ GPS saisi dans
# l'interface admin (Exploitation → Géolocalisation). Si absente, l'application
# se rabat sur DATA_ENCRYPTION_KEY puis JWT_SECRET. Recommandé en production.
# Générez-en une avec :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#PAJ_SECRET_KEY=

# --- Envoi d'emails (facultatif mais recommandé) ---------------------------
# Renseignez ces variables pour activer TOUS les emails automatiques :
#   • identifiants de connexion (à l'inscription) ;
#   • congés validés / refusés ;
#   • compteurs mis à jour (CP, RCC, heures supplémentaires) ;
#   • nouveau document adressé, signalement véhicule traité, convocation atelier.
# Sans ces variables, l'app fonctionne normalement mais n'envoie aucun email.
# Chaque salarié peut désactiver ces emails depuis « Mon profil ».
#
# Exemple avec une boîte OVH dédiée « noreply » (MX Plan / Email Pro) :
#SMTP_HOST=ssl0.ovh.net
#SMTP_PORT=465
#SMTP_SECURE=true
#SMTP_USER=noreply@inter-colis-services.com
#SMTP_PASS=motdepasse-de-la-boite-noreply
#MAIL_FROM=Inter Colis Services <noreply@inter-colis-services.com>
#APP_URL=https://inter-colis-services.com

# --- OSRM : temps & distances routiers réels (facultatif) ------------------
# Si défini, l'optimisateur de tournée utilise une instance OSRM pour calculer
# des temps de trajet routiers RÉELS (au lieu de l'estimation à vol d'oiseau)
# et afficher le vrai tracé sur la carte. Sans cette variable, l'app reste sur
# l'estimation (aucun changement). Le serveur fait le relais (pas d'ouverture
# du CSP côté navigateur).
#
# Recommandé : héberger OSRM sur votre VPS OVH avec Docker (données Normandie) :
#   mkdir -p ~/osrm && cd ~/osrm
#   wget https://download.geofabrik.de/europe/france/basse-normandie-latest.osm.pbf
#   docker run -t -v "$PWD:/data" osrm/osrm-backend osrm-extract -p /opt/car.lua /data/basse-normandie-latest.osm.pbf
#   docker run -t -v "$PWD:/data" osrm/osrm-backend osrm-partition /data/basse-normandie-latest.osrm
#   docker run -t -v "$PWD:/data" osrm/osrm-backend osrm-customize /data/basse-normandie-latest.osrm
#   docker run -d --restart always -p 5000:5000 -v "$PWD:/data" osrm/osrm-backend \
#     osrm-routed --algorithm mld /data/basse-normandie-latest.osrm
# Puis exposez-le derrière nginx en HTTPS et renseignez l'URL publique :
#OSRM_URL=https://osrm.inter-colis-services.com
# (Pour un test rapide uniquement : OSRM_URL=https://router.project-osrm.org
#  — serveur de démonstration public, NON destiné à la production.)

# --- Bot WhatsApp (facultatif) ---------------------------------------------
# Active l'API interne du bot WhatsApp (voir bot/README.md). Le bot tourne en
# PROCESSUS SÉPARÉ (npm run bot) et partage ce même BOT_TOKEN. Sans BOT_TOKEN,
# l'API du bot est désactivée et l'app fonctionne normalement.
# Générez-en un avec :  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#BOT_TOKEN=
# Numéro du bot affiché aux salariés dans « Mon profil » (facultatif).
#WA_BOT_NUMBER=+33 6 12 34 56 78
# (Processus bot) Mots-clés du SUJET d'un groupe déclenchant le mode entretien.
#WA_GROUP_KEYWORDS=entretien|atelier|m[eé]cano|v[eé]hicule|flotte

# --- Persistance Redis (facultatif, alternative au fichier JSON) -----------
# Inutile sur un VPS OVH : le fichier JSON est conservé sur le disque.
#KV_REST_API_URL=
#KV_REST_API_TOKEN=
